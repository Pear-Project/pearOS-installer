#!/bin/bash

# Setting useful variables
DIR="/usr/share/pearOS-installer/post-install"
installed=true
hypervisor=$(systemd-detect-virt)

# Log on desktop (default user when post-install runs after first boot)
LOG_DIR="/home/default/Desktop"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/post-install.log"
ERROR_FILE="/tmp/post-install-error"
rm -f "$ERROR_FILE"

exec > >(tee -a "$LOG_FILE")
exec 2>&1

# Stop on first error and show it instead of freezing
error_exit() {
  local msg="$1"
  echo "POST_INSTALL_ERROR: $msg" >> "$LOG_FILE"
  echo "$msg" > "$ERROR_FILE"
  echo "ERROR: $msg" >&2
  exit 1
}

has_internet() {
  ping -c 1 -W 3 8.8.8.8 &>/dev/null || curl -s --max-time 3 https://www.debian.org &>/dev/null
}

echo "=== pearOS Post-Install Script Started: $(date) ==="
set -x

if [ "$#" -ne 9 ]; then
  echo "KEYMAP=$1"
  echo "LOCALE=$2"
  echo "ZONE=$3"
  echo "user_passwd=(hidden)"
  echo "FULL_NAME=$5"
  echo "USER_NAME=$6"
  echo "HOST_NAME=$7"
  echo "UTC_ENABLED=$8"
  echo "THEME_MODE=$9"
  echo " ^ The above list represents your selected configurations."
  echo "Invalid number of arguments (expected 9)." > "$ERROR_FILE"
  exit 2
fi

# Various settings for the installation process
KEYMAP="$1" # us
LOCALE="$2" # en_US.UTF-8
ZONE="$3" # Europe/Bucharest
set +x
user_passwd="$4" # user password: pear
set -x
FULL_NAME="$5" # Full Name
USER_NAME="$6" # username (to log into your system)
HOST_NAME="$7" # hostname for the system
utc_enabled="$8" # true | false, from UI checkbox
THEME_MODE="$9" # dark | light, chosen on the "Choose Your Look" page

# Check the username
if printf "%s" "$USER_NAME" | grep -Eoq "^[a-z][a-z0-9-]*$" \
  && [ "${#USER_NAME}" -lt 33 ]; then
  if grep -Fxq "$USER_NAME" "$DIR"/reserved_usernames; then
    echo "Reserved username: $USER_NAME. Abort." > "$ERROR_FILE"
    exit 2
  fi
  else
    echo "Invalid Username: $USER_NAME. Abort." > "$ERROR_FILE"
    exit 2
  fi

# Remove the script from the autostart
echo "Removing autostart entry..."
rm -rf /etc/skel/.config/autostart/xyz.pearos-post-install.desktop

# ── Security-critical: create the real user + lock down 'default' ──────
# Done FIRST, before any config step below (keymap, locale, timezone,
# hostname, grub-mkconfig, ...). 'default' has passwordless root
# (NOPASSWD:ALL) + autologin from the base install; if account creation
# and 'default' removal were scheduled only near the end of this script,
# any earlier failure (bad keymap, locale.gen quirk, grub.cfg generation
# failing because /boot isn't mounted, etc.) would abort the script before
# ever locking the device down, leaving every shipped device permanently
# unauthenticated root on every boot.

set +x
if ! chpasswd <<<"default:$user_passwd"; then
  set -x
  error_exit "Failed to set password for $USER_NAME"
fi
set -x

echo "Scheduling finalization of $USER_NAME (rename from default) on next boot..."
if id "default" &>/dev/null; then
  cat > /usr/local/sbin/pearos-finalize-user.sh << FINALIZE
#!/bin/bash
exec >> /var/log/pearos-finalize-user.log 2>&1
echo "=== pearOS finalize-user: \$(date) ==="
set -x
usermod -l "$USER_NAME" -d "/home/$USER_NAME" -m -c "$FULL_NAME" -s /bin/bash -aG sudo default
if getent group default >/dev/null && [ "\$(id -gn "$USER_NAME")" = "default" ]; then
  groupmod -n "$USER_NAME" default
fi
grep -rlI "/home/default" "/home/$USER_NAME" 2>/dev/null | while read -r bookmark_file; do
  sed -i "s#/home/default#/home/$USER_NAME#g" "\$bookmark_file"
done
for f in /etc/sudoers /etc/sudoers.d/*; do
  [ -f "\$f" ] && sed -i '/^[[:space:]]*default[[:space:]]/d' "\$f"
done
visudo -c || true
systemctl disable pearos-finalize-user.service
rm -f /etc/systemd/system/pearos-finalize-user.service "\$0"
FINALIZE
  chmod 700 /usr/local/sbin/pearos-finalize-user.sh

  cat > /etc/systemd/system/pearos-finalize-user.service << 'UNIT'
[Unit]
Description=Rename pearOS default live user into the real user account
DefaultDependencies=no
Before=sddm.service display-manager.service
After=local-fs.target systemd-user-sessions.service
ConditionPathExists=/home/default

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pearos-finalize-user.sh

[Install]
WantedBy=sysinit.target
UNIT
  if ! systemctl enable pearos-finalize-user.service; then
    error_exit "Failed to schedule finalization of $USER_NAME"
  fi
  echo "$USER_NAME will be finalized (renamed from default) before SDDM starts on next boot"
else
  error_exit "Default user does not exist, cannot finalize $USER_NAME"
fi

# Set/load the keymap.
# localectl talks to systemd-localed over D-Bus/polkit, which isn't reliably
# available this early at first boot (fails with "Access denied" even as
# root). The keymap is applied for real below via /etc/vconsole.conf and the
# X11 config, so localectl/loadkeys here are best-effort only.
echo "Setting keymap to $KEYMAP..."
if ! localectl set-keymap "$KEYMAP"; then
  echo "WARNING: localectl could not set the keymap (no D-Bus/polkit session available); falling back to direct config files."
fi
if ! loadkeys "$KEYMAP"; then
  echo "WARNING: loadkeys failed to apply the keymap to the current console; it will still take effect via /etc/vconsole.conf."
fi

# Pushing Timezone to localtime file
echo "Setting timezone to $ZONE..."
if ! ln -sf /usr/share/zoneinfo/"$ZONE" /etc/localtime; then
  error_exit "Failed to set timezone: $ZONE"
fi

# Enable or disable UTC time. Not fatal - VMs (this ran under
# $hypervisor, from systemd-detect-virt) commonly have no real RTC
# device (/dev/rtc0) at all, so hwclock legitimately fails there; the
# system clock itself is already correct regardless (inherited from the
# live session / NTP), only the hardware clock's own persistence across
# a future reboot is affected, which isn't worth failing the whole OOBE
# over. Matches the WARNING-and-continue pattern already used above for
# localectl/loadkeys.
echo "Configuring hardware clock..."
if $utc_enabled; then
  if ! hwclock --systohc --utc; then
    echo "WARNING: hwclock could not sync to UTC (hypervisor=$hypervisor) - probably no real RTC device available; system clock is unaffected."
  fi
else
  if ! hwclock --systohc --localtime; then
    echo "WARNING: hwclock could not sync to localtime (hypervisor=$hypervisor) - probably no real RTC device available; system clock is unaffected."
  fi
fi

# Passing custom locale to locale file. The base image ships /etc/locale.gen
# with a large default set of locales already uncommented, and locale-gen
# (below) regenerates everything left uncommented - comment it all out first
# so only en_US.UTF-8 (baseline) and the chosen locale actually get built.
echo "Configuring locale: $LOCALE..."
sed -i '/^[a-zA-Z]/s/^/#/' /etc/locale.gen
if ! sed -i "s/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/" /etc/locale.gen; then
  error_exit "Failed to configure locale in /etc/locale.gen"
fi
if [ "$LOCALE" != "en_US.UTF-8" ]; then
  if ! sed -i "s/#$LOCALE/$LOCALE/" /etc/locale.gen; then
    error_exit "Failed to configure locale in /etc/locale.gen"
  fi
fi

# making the language equal to the locale, and passing to locale.conf
if ! echo "LANG=$LOCALE" | tee /etc/locale.conf; then
  error_exit "Failed to write /etc/locale.conf"
fi

# Persist the console keymap so it survives reboots (needed regardless of
# whether localectl above succeeded).
echo "Configuring console keymap..."
if ! echo "KEYMAP=$KEYMAP" | tee /etc/vconsole.conf; then
  error_exit "Failed to write /etc/vconsole.conf"
fi

# Configure X11 keyboard layout (for X11 desktop environments)
# Note: localectl set-keymap (called above) works for both X11 and Wayland
# This X11-specific config ensures compatibility with X11-only applications
if [ -d /usr/share/X11 ]; then
  echo "Configuring X11 keyboard layout..."
  if ! mkdir -p /etc/X11/xorg.conf.d; then
    echo "ERROR: Failed to create /etc/X11/xorg.conf.d directory" >&2
    exit 1
  fi
    if ! echo -e "Section \"InputClass\"\nIdentifier \"system-keyboard\"\nMatchIsKeyboard \"on\"\nOption \"XkbLayout\" \"$KEYMAP\"\nEndSection" > /etc/X11/xorg.conf.d/00-keyboard.conf; then
      error_exit "Failed to configure X11 keyboard"
    fi
  fi

# Note: For Wayland, localectl set-keymap (called above) is sufficient
# Most Wayland compositors (including Plasma Wayland) read keyboard layout from systemd/localectl
# Individual compositors may have additional config files, but localectl covers the base configuration

# Committing the locale settings
echo "Generating locale..."
if ! locale-gen; then
  error_exit "Failed to generate locale"
fi

# Setting the hostname
echo "Setting hostname to $HOST_NAME..."
if ! echo "$HOST_NAME" | tee /etc/hostname; then
  error_exit "Failed to set hostname"
fi

# Add the grub theme to the configuration file
echo "Generating grub configuration..."
if ! grub-mkconfig -o /boot/grub/grub.cfg; then
  error_exit "Failed to generate grub configuration"
fi

# Sync system clock if internet is available (a skewed clock can cause TLS
# and package timestamp issues for the steps below, e.g. cloning Liquid Gel).
echo "Checking internet connectivity..."
if has_internet; then
  echo "Internet available. Synchronizing system clock..."
  timedatectl set-ntp true
  for i in $(seq 1 10); do
    timedatectl show | grep -q "NTPSynchronized=yes" && break
    sleep 2
  done
  if ! timedatectl show | grep -q "NTPSynchronized=yes"; then
    echo "WARNING: NTP sync did not complete in time" >&2
  fi
else
  echo "No internet. Skipping NTP sync."
fi

# Backup sudoers before modifying
echo "Configuring sudo access..."
if [ -f /etc/sudoers ]; then
  cp /etc/sudoers /etc/sudoers.backup.$(date +%Y%m%d_%H%M%S)
fi

if ! sed -i 's/# %sudo\tALL=(ALL:ALL) ALL$/%sudo\tALL=(ALL:ALL) ALL/' /etc/sudoers; then
  error_exit "Failed to configure sudoers"
fi

echo "Adding user to sudo group..."
if ! echo "$USER_NAME   ALL=(ALL) ALL" | tee -a /etc/sudoers; then
  error_exit "Failed to add user to sudoers"
fi
if ! visudo -c -f /etc/sudoers; then
  error_exit "Sudoers file is invalid after modification"
fi

# NOPASSWD for specific pearOS apps (avoids password prompt for these only)
echo "Configuring passwordless sudo for pearOS apps..."
cat > /etc/sudoers.d/pearos-apps << EOF
$USER_NAME ALL=(ALL) NOPASSWD: /usr/bin/pearos-appstore, /usr/bin/pearos-welcome
EOF
chmod 0440 /etc/sudoers.d/pearos-apps
if ! visudo -c -f /etc/sudoers.d/pearos-apps; then
  rm -f /etc/sudoers.d/pearos-apps
  error_exit "Invalid sudoers.d/pearos-apps file, removed"
fi

# Profile picture: ~/.face.icon for new user and SDDM themes (critical for login screen)
echo "Setting profile picture (avatar)..."
PROFILE_PIC_FILE="/tmp/profile_picture"
if [ -f "$PROFILE_PIC_FILE" ] && [ -s "$PROFILE_PIC_FILE" ]; then
  PROFILE_PIC_SRC="$(cat "$PROFILE_PIC_FILE" | tr -d '\n\r')"
  # Only accept pictures bundled with the app (app/resources/profiles) -
  # this file is attacker-writable /tmp state, so resolve symlinks/.. and
  # reject anything outside the whitelisted directory before this root
  # script copies it anywhere (avoids leaking arbitrary root-readable files).
  PROFILE_PICS_DIR="$(realpath -m "$DIR/app/resources/profiles")"
  PROFILE_PIC_SRC="$(realpath -e "$PROFILE_PIC_SRC" 2>/dev/null)"
  case "$PROFILE_PIC_SRC" in
    "$PROFILE_PICS_DIR"/*) ;;
    *) echo "Rejected profile picture path outside $PROFILE_PICS_DIR" >&2; PROFILE_PIC_SRC="" ;;
  esac
  if [ -n "$PROFILE_PIC_SRC" ] && [ -f "$PROFILE_PIC_SRC" ] && [ -r "$PROFILE_PIC_SRC" ]; then
    # 1. New user's home avatar
    USER_HOME="/home/default"
    USER_FACE="$USER_HOME/.face.icon"
    if [ -d "$USER_HOME" ]; then
      if ! cp -f "$PROFILE_PIC_SRC" "$USER_FACE"; then
        error_exit "Failed to copy profile picture to $USER_FACE"
      fi
      echo "Profile picture set for user $USER_NAME"
    fi

    # 1b. AccountsService (what SDDM's multi-user list actually reads: home
    # directories are 0700 per login.defs HOME_MODE, so the sddm daemon user
    # can't stat ~/.face.icon - /var/lib/AccountsService/icons is world-
    # readable and is what qmlUserModel.icon resolves against first).
    ACCOUNTSSERVICE_ICONS_DIR="/var/lib/AccountsService/icons"
    ACCOUNTSSERVICE_USERS_DIR="/var/lib/AccountsService/users"
    ACCOUNTSSERVICE_ICON="$ACCOUNTSSERVICE_ICONS_DIR/$USER_NAME"
    if mkdir -p "$ACCOUNTSSERVICE_ICONS_DIR" "$ACCOUNTSSERVICE_USERS_DIR"; then
      if cp -f "$PROFILE_PIC_SRC" "$ACCOUNTSSERVICE_ICON"; then
        chmod 0644 "$ACCOUNTSSERVICE_ICON"
        cat > "$ACCOUNTSSERVICE_USERS_DIR/$USER_NAME" << EOF
[User]
Icon=$ACCOUNTSSERVICE_ICON
SystemAccount=false
EOF
        chmod 0600 "$ACCOUNTSSERVICE_USERS_DIR/$USER_NAME"
        echo "Profile picture registered with AccountsService for $USER_NAME"
      else
        echo "WARNING: Failed to copy profile picture to $ACCOUNTSSERVICE_ICON" >&2
      fi
    else
      echo "WARNING: Failed to create AccountsService directories" >&2
    fi

    # 2. Extras (global profile picture)
    EXTRAS_FACE="/usr/share/extras/.face.icon"
    if ! mkdir -p /usr/share/extras; then
      error_exit "Failed to create /usr/share/extras"
    fi
    if ! cp -f "$PROFILE_PIC_SRC" "$EXTRAS_FACE"; then
      error_exit "Failed to copy profile picture to $EXTRAS_FACE"
    fi
    if [ ! -f "$EXTRAS_FACE" ] || [ ! -s "$EXTRAS_FACE" ]; then
      error_exit "Profile picture missing or empty after copy: $EXTRAS_FACE"
    fi
    echo "Profile picture set in /usr/share/extras"

    # 3. SDDM themes – mandatory; do not skip
    # pearOS theme uses images/.face.icon as fallback (Main.qml); some use faces/.face.icon
    SDDM_THEMES="pearOS pearOS-dark"
    for theme in $SDDM_THEMES; do
      THEME_ROOT="/usr/share/sddm/themes/$theme"
      for subdir in faces images; do
        SDDM_DIR="$THEME_ROOT/$subdir"
        SDDM_FACE="$SDDM_DIR/.face.icon"
        if ! mkdir -p "$SDDM_DIR"; then
          error_exit "Failed to create SDDM directory: $SDDM_DIR"
        fi
        if ! cp -f "$PROFILE_PIC_SRC" "$SDDM_FACE"; then
          error_exit "Failed to copy profile picture to SDDM theme $theme ($subdir): $SDDM_FACE"
        fi
        if [ ! -f "$SDDM_FACE" ] || [ ! -s "$SDDM_FACE" ]; then
          error_exit "SDDM profile picture missing or empty after copy: $SDDM_FACE"
        fi
      done
      echo "Profile picture set for SDDM theme: $theme (faces + images)"
    done
  else
    echo "Profile picture source missing or not readable: $PROFILE_PIC_SRC" >&2
  fi
else
  echo "No profile picture selected (/tmp/profile_picture missing or empty), skipping avatar setup"
fi

# Fix extras files permissions (fixes the theme-switcher bug)
echo "Fixing permissions for extras..."
if ! chmod -R 0777 /usr/share/extras; then
  echo "WARNING: Failed to set permissions on /usr/share/extras" >&2
fi

# Everything below this point applies choices collected by pages that ran
# as the live 'default' user, before $USER_NAME existed as its final name
# (Choose Your Look, Accessibility, Analytics, Screen Time, Touch ID). None
# of those pages could apply their setting directly - kwriteconfig6/xkbset/
# fprintd-enroll would have landed under 'default's own session - so they
# only left their choice in /tmp/*. This is the other half of that handoff,
# same idea as the profile-picture copy above, just for settings instead of
# a file. default's home is what pearos-finalize-user.service renames into
# $USER_NAME's home at next boot, so everything written into it here below
# carries over automatically.
USER_HOME="/home/default"
AUTOSTART_DIR="$USER_HOME/.config/autostart"
SCRIPTS_DIR="$USER_HOME/.config/pearos-scripts"
HAVE_USER_HOME=false
if [ -d "$USER_HOME" ]; then
  HAVE_USER_HOME=true
  mkdir -p "$AUTOSTART_DIR" "$SCRIPTS_DIR"
fi

# A one-shot autostart entry + script, self-deleting after it runs once -
# the mechanism every "needs a live session" step below schedules through.
# $1=name (used in file names), $2=script body (without the shebang line).
schedule_first_login() {
  local name="$1" body="$2"
  local script="$SCRIPTS_DIR/apply-first-$name.sh"
  local desktop="$AUTOSTART_DIR/pearos-first-$name.desktop"
  {
    echo "#!/bin/bash"
    echo "$body"
    echo "rm -f \"$desktop\""
    echo "rm -f \"\$0\""
  } > "$script"
  chmod +x "$script"
  cat > "$desktop" << EOF
[Desktop Entry]
Type=Application
Exec=bash "$script"
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
Name=pearOS First $name Setup
EOF
}

# ── Look (dark/light theme) ──────────────────────────────────────────
echo "Applying theme preference for $USER_NAME..."
THEME_SWITCHER="/usr/share/extras/system-settings/themeswitcher/kde-theme-switch.sh"
THEME_STATE_FILE="/usr/share/extras/system-settings/themeswitcher/state"
case "$THEME_MODE" in
  dark|light) ;;
  *)
    # Defensive fallback if THEME_MODE wasn't 'dark'/'light' (shouldn't
    # happen - the UI always sends one of the two): reuse whatever 'default'
    # had, same detection the theme switcher uses internally.
    THEME_MODE="light"
    if [ -f "$THEME_STATE_FILE" ]; then
      saved_mode="$(tr '[:upper:]' '[:lower:]' < "$THEME_STATE_FILE" | tr -d '\n\r\t ')"
      [ "$saved_mode" = "dark" ] && THEME_MODE="dark"
    elif [ -d /home/default ]; then
      default_scheme="$(su - default -c 'kreadconfig6 --file kdeglobals --group General --key ColorScheme' 2>/dev/null || echo "")"
      echo "$default_scheme" | grep -qi "dark" && THEME_MODE="dark"
    fi
    ;;
esac
echo "Theme mode to apply: $THEME_MODE"
# kde-theme-switch.sh needs a real, running Plasma session (DBus, XDG_RUNTIME_DIR)
# to fully apply itself (GTK/Kvantum/etc components run partially otherwise).
# The new user has no session yet at this point in the script, so instead of
# faking one, drop a one-shot autostart entry that runs the switcher on the
# user's own first real login (schedule_first_login(), defined above).
if [ -x "$THEME_SWITCHER" ] && $HAVE_USER_HOME; then
  schedule_first_login "theme" "\"$THEME_SWITCHER\" --$THEME_MODE"
  echo "Scheduled theme application for $USER_NAME on first login"
else
  echo "Theme switcher not found or $USER_NAME home missing, skipping theme sync" >&2
fi

# ── Accessibility + Analytics ────────────────────────────────────────
# kdeglobals/kcminputrc are plain files - no live session needed, so these
# apply immediately (as $USER_NAME, into their own freshly-created home).
if $HAVE_USER_HOME && { [ -f /tmp/accessibility_prefs ] || [ -f /tmp/analytics_prefs ]; }; then
  echo "Applying accessibility/analytics preferences for $USER_NAME..."
  get_pref() { grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2; }

  REDUCE_MOTION="$(get_pref /tmp/accessibility_prefs reduce_motion)"
  INCREASE_CONTRAST="$(get_pref /tmp/accessibility_prefs increase_contrast)"
  LARGER_CURSOR="$(get_pref /tmp/accessibility_prefs larger_cursor)"
  SEND_DIAGNOSTICS="$(get_pref /tmp/analytics_prefs send_diagnostics)"
  SHARE_CRASH_DATA="$(get_pref /tmp/analytics_prefs share_crash_data)"

  run_as_user() { su - default -c "$1" 2>/dev/null || true; }

  [ "$REDUCE_MOTION" = "True" ] && \
    run_as_user "kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 0"
  [ "$INCREASE_CONTRAST" = "True" ] && \
    run_as_user "kwriteconfig6 --file kdeglobals --group KDE --key contrast 10"
  [ "$LARGER_CURSOR" = "True" ] && \
    run_as_user "kwriteconfig6 --file kcminputrc --group Mouse --key cursorSize 48"
  [ -n "$SEND_DIAGNOSTICS" ] && \
    run_as_user "kwriteconfig6 --file kdeglobals --group Privacy --key SendDiagnostics $([ "$SEND_DIAGNOSTICS" = "True" ] && echo true || echo false)"
  [ -n "$SHARE_CRASH_DATA" ] && \
    run_as_user "kwriteconfig6 --file kdeglobals --group Privacy --key ShareCrashData $([ "$SHARE_CRASH_DATA" = "True" ] && echo true || echo false)"

  # Sticky/Slow/Bounce/Mouse Keys + the audible bell are XKB AccessX
  # controls, i.e. live X11-session state, not a config file - these can
  # only take effect once $USER_NAME actually has a session, same as the
  # theme switch above.
  ACCESSX_CMD=""
  add_accessx() {
    [ "$(get_pref /tmp/accessibility_prefs "$1")" = "True" ] && ACCESSX_CMD="$ACCESSX_CMD xkbset $2;"
  }
  add_accessx sticky_keys sticky
  add_accessx slow_keys slowkeys
  add_accessx bounce_keys bouncekeys
  add_accessx mouse_keys mousekeys
  if [ "$(get_pref /tmp/accessibility_prefs audible_bell)" = "False" ]; then
    ACCESSX_CMD="$ACCESSX_CMD xkbset -bell;"
  fi
  if [ -n "$ACCESSX_CMD" ] && $HAVE_USER_HOME; then
    schedule_first_login "accessx" "$ACCESSX_CMD"
    echo "Scheduled AccessX preferences for $USER_NAME on first login"
  fi
else
  echo "No accessibility/analytics preferences recorded, skipping"
fi

# ── Screen Time ───────────────────────────────────────────────────────
if [ "$(cat /tmp/screentime_enabled 2>/dev/null)" = "true" ] && $HAVE_USER_HOME; then
  echo "Setting up Screen Time for $USER_NAME..."
  ST_DATA_DIR="$USER_HOME/.local/share/pearos-settings"
  ST_COLLECTOR="$ST_DATA_DIR/screentime-collector.py"
  ST_KWIN="$ST_DATA_DIR/screentime-kwin.js"
  ST_SYSTEMD_DIR="$USER_HOME/.config/systemd/user"
  ST_SERVICE="$ST_SYSTEMD_DIR/pearos-screentime.service"

  mkdir -p "$ST_DATA_DIR" "$ST_SYSTEMD_DIR"
  cp "$DIR/first_login_assets/screentime-collector.py" "$ST_COLLECTOR"
  chmod +x "$ST_COLLECTOR"
  cp "$DIR/first_login_assets/screentime-kwin.js" "$ST_KWIN"
  cat > "$ST_SERVICE" << EOF
[Unit]
Description=PearOS Screen Time collector

[Service]
Type=simple
ExecStart=/usr/bin/python3 "$ST_COLLECTOR"
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
EOF

  # Loading the KWin script and enabling the systemd --user unit both need
  # a live session (D-Bus, systemd --user instance) - defer to first login.
  schedule_first_login "screentime" "
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript pearos-screentime >/dev/null 2>&1
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript \"$ST_KWIN\" pearos-screentime >/dev/null 2>&1
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null 2>&1
systemctl --user daemon-reload
systemctl --user enable --now pearos-screentime.service >/dev/null 2>&1
"
  echo "Scheduled Screen Time activation for $USER_NAME on first login"
fi

# ── Touch ID ──────────────────────────────────────────────────────────
# The fingerprint was necessarily enrolled under 'default' during the
# wizard (see pages/touchid_setup.py's docstring for why) - migrate
# fprintd's on-disk print data to the real user, same idea as the profile
# picture copy. Non-fatal: if fprintd's storage layout ever changes and
# this copy does nothing useful, the user can just re-enroll from Settings.
if [ "$(cat /tmp/touchid_enabled 2>/dev/null)" = "true" ] && $HAVE_USER_HOME; then
  echo "Migrating Touch ID enrollment to $USER_NAME..."
  if [ -d /var/lib/fprint/default ] && [ -n "$(ls -A /var/lib/fprint/default 2>/dev/null)" ]; then
    if mkdir -p "/var/lib/fprint/$USER_NAME" && \
       cp -r /var/lib/fprint/default/. "/var/lib/fprint/$USER_NAME/" 2>/dev/null; then
      echo "Touch ID enrollment migrated to $USER_NAME"
    else
      echo "WARNING: Failed to migrate Touch ID enrollment to $USER_NAME" >&2
    fi
  else
    echo "WARNING: Touch ID was enabled but no enrollment data found under 'default'" >&2
  fi
fi

# ── PearID ────────────────────────────────────────────────────────────
# pearID/token_storage.sh saves the session token to whichever of two
# places it picked - a keyring entry scoped to 'default's own login
# session (nothing to do, that session is gone after the rename anyway),
# or, if no secret service was available, a plain file at ~/.pearid_token
# - already sitting in $USER_HOME since it's the same account, just not
# renamed yet.
if $HAVE_USER_HOME && [ -f "$USER_HOME/.pearid_token" ]; then
  chmod 600 "$USER_HOME/.pearid_token"
fi

# Remove useless packages and their desktop entries
echo "Removing unnecessary packages..."
if ! LC_ALL=en_US.UTF-8 DEBIAN_FRONTEND=noninteractive apt-get purge -y electron npm plasma-sdk discover pearos-livecd-desktop; then
  echo "WARNING: Some packages failed to remove" >&2
fi

echo "Removing desktop entries..."
rm -rf /usr/share/applications/avahi-discover.desktop \
       /usr/share/applications/bssh.desktop \
       /usr/share/applications/bvnc.desktop \
       /usr/share/applications/qv4l2.desktop \
       /usr/share/applications/qvidcap.desktop \
       /usr/share/applications/org.kde.plasma.emojier \
       /usr/share/applications/calamares*

# Remove sddm.conf > it is set to autologin user 'default', which breaks the system
echo "Removing old SDDM configuration..."
if [ -f /etc/sddm.conf ]; then
  cp /etc/sddm.conf /etc/sddm.conf.backup.$(date +%Y%m%d_%H%M%S)
  rm -f /etc/sddm.conf
fi

# Fixing the SDDM theme
echo "Configuring SDDM theme..."
cat > /etc/sddm.conf << 'EOF'
[Autologin]
Session=plasma

[Theme]
Current=pearOS
EOF

if [ $? -ne 0 ]; then
  error_exit "Failed to write SDDM configuration"
fi

# Liquid Gel: requires internet to download source and packages
if has_internet; then
  echo "Installing cmake and extra-cmake-modules for Liquid Gel build..."
  if ! DEBIAN_FRONTEND=noninteractive apt-get install -y cmake extra-cmake-modules 2>> "$LOG_FILE"; then
    echo "Warning: Failed to install cmake/extra-cmake-modules" >&2
  fi

  echo "Downloading Liquid Gel"
  if git clone https://github.com/pearOS-archlinux/liquid-gel /tmp/liquid-gel 2>> "$LOG_FILE"; then
    echo "Liquid Gel Downloaded..."
  else
    echo "Failed to download Liquid Gel" >&2
  fi

#  if [ -d /tmp/liquid-gel ]; then
#    echo "Compiling Liquid Gel"
#    if ( cd /tmp/liquid-gel && mkdir -p build && cd build && cmake .. -DCMAKE_INSTALL_PREFIX=/usr && make -j"$(nproc)" 2>> "$LOG_FILE" && make install 2>> "$LOG_FILE" ); then
#      echo "Liquid Gel Compiled..."
#    else
#      echo "Failed to Compile Liquid Gel - Build Failed" >&2
#      echo "Failed to install Liquid Gel" >&2
#    fi

#    echo "Cleanup Liquid Gel source"
#    if rm -rf /tmp/liquid-gel; then
#      echo "Finish cleanup"
#    else
#      echo "Failed to Cleanup files" >&2
#    fi
#  fi

  echo "Removing cmake and extra-cmake-modules..."
  if ! DEBIAN_FRONTEND=noninteractive apt-get purge -y cmake extra-cmake-modules 2>> "$LOG_FILE"; then
    echo "Warning: Failed to remove cmake/extra-cmake-modules" >&2
  fi
else
  echo "No internet. Skipping Liquid Gel installation."
fi

echo "=== pearOS Installation Script Completed: $(date) ==="
sync
shutdown -r now
